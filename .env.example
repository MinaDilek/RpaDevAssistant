OPENAI_API_KEY=
OpenAI__Model=gpt-5.6-mini
OpenAI__MaxOutputTokens=1200
AI__Provider=OpenAI
# Local provider example (the endpoint must resolve directly to localhost/loopback):
# AI__Provider=Local
# AI__LocalEndpoint=http://127.0.0.1:11434/v1/responses
# AI__LocalModel=your-local-model
# AI__LocalApiKey=
RPADA_ALLOWED_ORIGINS=
RpaDevAssistant__Storage__CustomRulesFile=
RpaDevAssistant__Storage__RuleProfilesFile=
RpaDevAssistant__Storage__AnalysisHistoryRoot=
RpaDevAssistant__History__MaxSnapshotsPerProject=20
RpaDevAssistant__SourceControl__GitHub__AccessToken=
RpaDevAssistant__SourceControl__GitLab__AccessToken=
RpaDevAssistant__SourceControl__AzureDevOps__BaseUrl=
RpaDevAssistant__SourceControl__AzureDevOps__AccessToken=
RpaDevAssistant__SourceControl__RequestTimeoutSeconds=15
