  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  x:Class="Business.SendMail">
  <Sequence DisplayName="Send Mail">
    <Sequence.Activities>
      <ui:SendMail DisplayName="Send notification email" To="ops@example.com" Subject="Robot completed" Body="Process completed" />
    </Sequence.Activities>
  </Sequence>
</Activity>
