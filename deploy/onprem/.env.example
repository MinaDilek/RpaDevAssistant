RPADA_PORT=8080
RPADA_PROJECTS_ROOT=/srv/uipath-projects
# Generate with: openssl rand -base64 48
RPADA_CENTRAL_BOOTSTRAP_API_KEY=replace-with-at-least-32-random-characters
RPADA_AUTH_MODE=ApiKey
RPADA_ALLOWED_ORIGIN=http://127.0.0.1:8080
# Required only when RPADA_AUTH_MODE is Oidc or Hybrid.
RPADA_OIDC_AUTHORITY=
RPADA_OIDC_AUDIENCE=
RPADA_OIDC_TENANT_CLAIM=tid
RPADA_OIDC_SUBJECT_CLAIM=sub
RPADA_LICENSE_REQUIRED=false
RPADA_LICENSES_ROOT=./licenses
RPADA_LICENSE_FILE=/licenses/license.json
RPADA_LICENSE_PUBLIC_KEY_FILE=/licenses/public.pem
