{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for local project selection and backend sidecar startup.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "process:allow-restart",
    "shell:allow-spawn",
    "shell:allow-kill",
    "updater:default"
  ]
}
